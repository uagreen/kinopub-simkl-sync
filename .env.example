# Required. Register an app at https://simkl.com/settings/developer with the
# standard OAuth2 flow enabled and put its credentials here.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# Optional. Only needed if you registered the Simkl app with a non-default
# redirect URI (default: http://localhost:8000/callback). Must match exactly.
# SIMKL_REDIRECT_URI=http://localhost:8000/callback

# Optional. Only needed if api.service-kp.com is blocked on your network.
# KINOPUB_API_URL=https://cdn-service.online/api

# Optional. Only needed for `kts push --myshows` / `kts sync --myshows`.
MYSHOWS_USERNAME=
MYSHOWS_PASSWORD=

# Optional. Only needed for `kts push --floppy` / `kts sync --floppy`.
# FLOPPY_URL is your own self-hosted instance; FLOPPY_API_TOKEN comes from
# its Settings -> Integrations; TMDB_API_KEY is free at
# https://www.themoviedb.org/settings/api (used to resolve imdb -> tmdb ids,
# since Floppy's watch endpoints don't accept imdb as a source).
FLOPPY_URL=
FLOPPY_API_TOKEN=
TMDB_API_KEY=
